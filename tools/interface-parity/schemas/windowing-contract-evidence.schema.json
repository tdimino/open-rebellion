{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-rebellion.example/schemas/windowing-contract-evidence-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagnostics", "artifacts"],
  "properties": {
    "schema_version": { "const": 1 },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["errors", "requests"],
      "properties": {
        "errors": { "type": "array", "maxItems": 0 },
        "requests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "status"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "status": { "type": "integer", "minimum": 200, "maximum": 399 }
            }
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "sha256"],
        "properties": {
          "kind": { "enum": ["result_json", "screenshot", "fixture_wasm"] },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    }
  }
}
