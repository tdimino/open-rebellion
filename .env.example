# Absolute path on the HOST machine to your own legal Star Wars Rebellion
# installation (GOG/Steam/CD), the directory containing GData/, MDATA/, and
# the game DLLs (COMMON.DLL, GOKRES.DLL, STRATEGY.DLL, TACTICAL.DLL).
#
# This is mounted read-only into the builder container. The game files
# themselves are never copied into a Docker image layer or committed to git.
STAR_WARS_REBELLION_DIR=/path/to/star-wars-rebellion

# Set to 1 to force reconversion/redecoding of cutscenes even if already
# staged (normally skipped for speed on repeated `docker compose up`).
FORCE_REBUILD=0

# Web client port
WEB_PORT=8095

# Set to 1 to also dump every original .DAT table + TEXTSTRA.DLL name strings
# to data/base/json/ — the reference modders need (dat_id values, field
# names/current values) to write mod overlay patches. See README_MOD.md.
PREPARE_MODDING=0
