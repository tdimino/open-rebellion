{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-rebellion.example/schemas/encyclopedia-manifest-v1.schema.json",
  "$comment": "E09 V1 WIRE CONTRACT — COORDINATOR APPROVED 2026-09-29. This manifest authenticates only the immutable serialized base catalog and base runtime files; it does not prove runtime world/viewer admission or observed cache membership. E31 owns the future source-to-world/viewer adapter and hands typed admitted BindingKeys plus admission facts to the world-independent E44 resolver. Production readiness remains gated by E31, E32, and E51; the approved wire contract does not depend on E31, E32, or E51 runtime work. Runtime effective facts, exact-name generated mod IDs, candidate identity buffers, and aliases are not file-schema fields and never enter this manifest.",
  "title": "Open Rebellion immutable base encyclopedia manifest v1 (coordinator-approved wire contract)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_profile",
    "extractor_version",
    "catalog_sha256",
    "files",
    "binding_sources",
    "source_records"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "source_profile": { "$ref": "#/$defs/token" },
    "extractor_version": { "$ref": "#/$defs/token" },
    "catalog_sha256": { "$ref": "#/$defs/sha256" },
    "files": { "$ref": "#/$defs/files" },
    "binding_sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/bindingSource" }
    },
    "source_records": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 100000,
      "propertyNames": { "$ref": "#/$defs/sourceRef" },
      "additionalProperties": { "$ref": "#/$defs/sourceRecord" }
    }
  },
  "$defs": {
    "token": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "sourceRef": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,255}$"
    },
    "basename": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "files": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 20001,
      "required": ["catalog.json"],
      "properties": {
        "catalog.json": { "$ref": "#/$defs/sha256" }
      },
      "patternProperties": {
        "^assets/(?:[A-Za-z0-9][A-Za-z0-9._-]{0,126}/)*[A-Za-z0-9][A-Za-z0-9._-]{0,127}$": {
          "$ref": "#/$defs/sha256"
        }
      },
      "additionalProperties": false
    },
    "bindingSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basename", "sha256"],
      "properties": {
        "basename": { "$ref": "#/$defs/basename" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "resourceIdentifier": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "numeric" },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "value"],
          "properties": {
            "kind": { "const": "named" },
            "value": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      ]
    },
    "sourceRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_basename",
        "source_sha256",
        "resource_type",
        "resource_id",
        "language_id",
        "raw_length",
        "raw_sha256",
        "decoder",
        "encoding",
        "mapping_citations"
      ],
      "properties": {
        "source_basename": { "$ref": "#/$defs/basename" },
        "source_sha256": { "$ref": "#/$defs/sha256" },
        "resource_type": { "$ref": "#/$defs/resourceIdentifier" },
        "resource_id": { "$ref": "#/$defs/resourceIdentifier" },
        "language_id": {
          "type": "integer",
          "minimum": 0,
          "maximum": 65535
        },
        "raw_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 33554432
        },
        "raw_sha256": { "$ref": "#/$defs/sha256" },
        "decoder": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "encoding": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "mapping_citations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          }
        }
      }
    }
  }
}
