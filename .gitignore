/target
.osgrep/
*.swp
*.swo
*~
.DS_Store

# Local Docker env (host paths, never committed)
.env

# Game data (not redistributable). Blanket-ignore the whole directory rather
# than per-extension globs: a real install copy also drops in .sav save
# files, .FDT/.SPT files, and mixed-case names (unins000.dat, d3drm.dll)
# that case-sensitive `*.DAT`/`*.DLL` patterns silently missed.
data/base/*
!data/base/.gitkeep

# 3D model staging and intermediates (not checked in)
scripts/models-staging/
scripts/models-optimized/
scripts/logs/

# Ghidra project files (binary, large)
ghidra/
!ghidra/README.md
*.gpr
*.rep/
*.lock
*.lock~
# Reference images (extracted from game, not redistributable)
# Keep prompt templates, ignore the actual PNGs
assets/references/**/*.png

# Generated assets (large, reproducible)
data/generated/
/dist/

# HD upscaled assets (generated, not redistributable)
data/hd/
data/sounds/

# WASM staged data (copied by build-wasm.sh)
web/data/
web/open-rebellion.wasm

# Reference videos (decoded from Smacker, large)
assets/references/ref-videos/
assets/references/cutscene-frames/
assets/references/ref-ui-full/

# Autoresearch intermediate outputs
*.jsonl
progress.json

# Subdaimon outputs
.subdaimon-output/

# Local-only automation definitions and machine-local test links
.github/workflows/
sharpen-test

# Claude Code project files
.claude/

# QA screenshots
docs/qa/*.png

# Reference books (copyrighted, large)
assets/references/ref-illustrated-books/

# Misc generated/local files
clippy.toml
rustfmt.toml
data/character-portrait-art-sources.md
data/reference-selections.json
playtest-dual-sample.jsonl
docs/plans/2026-03-23-002-feat-ui-parity-execplan.md
docs/plans/2026-03-24-001-knesset-demiurge-ui-parity.md
docs/plans/2026-03-24-002-knesset-sassuratu-visual-qa-parity.md
docs/qa/*
!docs/qa/2026-09-08-full-functionality-audit/
!docs/qa/2026-09-08-full-functionality-audit/**

# Ghidra site generated files
ghidra-site/

# Stage scripts
scripts/stage-ui-assets.py
scripts/download-ot-portraits*.py

# autoresearch lab
.lab/

# Python bytecode
__pycache__/
*.pyc
.osgrep
