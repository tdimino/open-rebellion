assets/references/**/*.png

# Generated assets (large, reproducible)
data/generated/

# HD upscaled assets (generated, not redistributable)
data/hd/
data/sounds/

# WASM staged data (copied by build-wasm.sh)
web/data/
web/open-rebellion.wasm

# Staged UI assets (extracted from DLLs)
